{
  "name": "carteasso",
  "version": "0.1.0",
  "private": true,
  "description": "CarteAsso — la carte du territoire de tes assos (backend + intégrations)",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @carteasso/api start:dev",
    "dev:web": "pnpm --filter @carteasso/web dev",
    "db:migrate": "pnpm --filter @carteasso/api db:migrate",
    "db:seed": "pnpm --filter @carteasso/api db:seed",
    "search:reindex": "pnpm --filter @carteasso/api search:reindex",
    "import:rna": "pnpm --filter @carteasso/api import:rna"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.5.0",
      "qs": ">=6.16.1",
      "body-parser": ">=2.4.0",
      "proxy-addr": ">=2.0.8"
    }
  }
}
